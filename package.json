{
  "name": "switcher",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "switcher": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "koffi": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
