{
  "name": "qdesk",
  "version": "1.0.14",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakeBeaver/qdesk.git"
  },
  "bugs": {
    "url": "https://github.com/JakeBeaver/qdesk/issues"
  },
